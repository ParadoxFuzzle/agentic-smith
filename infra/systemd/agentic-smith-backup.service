[Unit]
Description=Create and verify a Agentic Smith production backup
Requires=docker.service
After=docker.service

[Service]
Type=oneshot
EnvironmentFile=-/etc/agentic-smith/backup.env
ExecStart=/usr/local/sbin/agentic-smith-backup
Nice=10
IOSchedulingClass=best-effort
IOSchedulingPriority=7
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/backups
