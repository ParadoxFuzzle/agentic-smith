[Desktop Entry]
Type=Application
Name=Agentic Smith Browser
Comment=Chromium with Agentic Smith container flags and profile isolation
Exec=/usr/local/bin/agentic-smith-browser %U
Terminal=false
Categories=Network;WebBrowser;
MimeType=x-scheme-handler/http;x-scheme-handler/https;text/html;
StartupNotify=false
