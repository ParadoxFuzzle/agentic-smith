{
  "name": "@agentic-smith/desktop",
  "productName": "Agentic Smith",
  "version": "0.8.0",
  "author": {
    "name": "Jerith AI"
  },
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "dev": "pnpm build && electron .",
    "build": "node scripts/build.mjs && node scripts/copy-static.mjs && node scripts/build-speech.mjs",
    "pack": "pnpm --filter @agentic-smith/web build && pnpm build && electron-builder --mac --win --linux",
    "pack:dir": "pnpm --filter @agentic-smith/web build && pnpm build && electron-builder --dir",
    "check": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.jsdom.json && tsc --noEmit -p e2e/tsconfig.json && tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run --root ../.. apps/desktop/src",
    "test:e2e": "pnpm build && playwright test --config e2e/playwright.config.ts",
    "release": "pnpm --filter @agentic-smith/web build && pnpm build && electron-builder --publish never"
  },
  "dependencies": {
    "@agentic-smith/contracts": "workspace:*",
    "@agentic-smith/logging": "workspace:*",
    "@sentry/electron": "8.3.0",
    "electron-updater": "6.8.11",
    "koffi": "3.3.7"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "@agentic-smith/adapters": "workspace:*",
    "@agentic-smith/core": "workspace:*",
    "@agentic-smith/ui-tokens": "workspace:*",
    "electron": "45.2.3",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2",
    "vitest": "4.1.12",
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "dev.agenticsmith.desktop",
    "directories": {
      "output": "out",
      "buildResources": "assets"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../web/dist",
        "to": "web"
      },
      {
        "from": "../../infra/compose/docker-compose.images.yml",
        "to": "stack/docker-compose.images.yml"
      },
      {
        "from": "../../infra/compose/.env.images.example",
        "to": "stack/.env.images.example"
      }
    ],
    "extraMetadata": {
      "name": "agentic-smith",
      "main": "dist/main.js"
    },
    "mac": {
      "icon": "../../packages/ui-tokens/assets/AgenticSmith.icon",
      "category": "public.app-category.productivity",
      "x64ArchFiles": "{**/node_modules/@koromix/koffi-darwin-*/darwin_*/koffi.node,**/node_modules/@oxc-parser/binding-darwin-*/parser.darwin-*.node}",
      "entitlements": "assets/entitlements.mac.plist",
      "entitlementsInherit": "assets/entitlements.mac.plist",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Agentic Smith uses the microphone for dictation and voice calls with your bots.",
        "NSSpeechRecognitionUsageDescription": "Agentic Smith turns what you say into text for dictation and voice calls with your bots."
      },
      "extraResources": [
        {
          "from": "build/speech/agentic-smith-speech",
          "to": "speech/agentic-smith-speech"
        },
        {
          "from": "assets/es.lproj",
          "to": "es.lproj"
        },
        {
          "from": "assets/pl.lproj",
          "to": "pl.lproj"
        }
      ],
      "target": [
        "dmg",
        "zip"
      ],
      "notarize": true
    },
    "dmg": {
      "title": "${productName}",
      "iconSize": 100,
      "window": {
        "width": 660,
        "height": 400
      },
      "contents": [
        {
          "x": 170,
          "y": 175,
          "type": "file"
        },
        {
          "x": 490,
          "y": 175,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "nsis": {
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        "nsis"
      ],
      "verifyUpdateCodeSignature": true
    },
    "linux": {
      "executableName": "agentic-smith",
      "icon": "assets/icon.png",
      "target": [
        "AppImage"
      ],
      "artifactName": "Agentic-Smith-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "jerithai",
        "repo": "agentic-smith"
      }
    ]
  }
}
